
pipeline {
    agent any

    environment {
        SERVER_IP   = '192.168.0.84'
        SERVER_USER = 'kiran'
        SSH_PORT    = '2222'
        DEPLOY_DIR  = '/var/www/kiran'
        SSH_KEY     = '/home/kiran.kk@TA.COM/.ssh/id_private_key'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Files') {
            steps {
                sh '''
                    set -e
                    echo "Checking website files..."
                    test -f html/index.html
                    echo "index.html found."
                '''
            }
        }

        stage('Deploy Website') {
            steps {
                sh '''
                    set -e

                    scp -i "$SSH_KEY" -P "$SSH_PORT" \
                        html/index.html \
                        "${SERVER_USER}@${SERVER_IP}:/tmp/index.html"

                    ssh -i "$SSH_KEY" -p "$SSH_PORT" \
                        "${SERVER_USER}@${SERVER_IP}" \
                        "sudo -n install -m 644 /tmp/index.html ${DEPLOY_DIR}/index.html"
                '''
            }
        }

        stage('Nginx Configuration') {
            steps {
                sh '''
                    set -e

                    ssh -i "$SSH_KEY" -p "$SSH_PORT" \
                        "${SERVER_USER}@${SERVER_IP}" \
                        'sudo -n tee /etc/nginx/sites-available/kiran > /dev/null' <<'NGINX'
server {
    listen 8083;
    server_name _;

    root /var/www/kiran;
    index index.html;
}
NGINX

                    ssh -i "$SSH_KEY" -p "$SSH_PORT" \
                        "${SERVER_USER}@${SERVER_IP}" \
                        'set -e
                         if [ ! -L /etc/nginx/sites-enabled/kiran ]; then
                             sudo -n ln -s /etc/nginx/sites-available/kiran /etc/nginx/sites-enabled/kiran
                         fi
                         sudo -n nginx -t
                         if systemctl is-active --quiet nginx; then
                             sudo -n systemctl reload nginx
                         else
                             sudo -n systemctl start nginx
                         fi'
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -e
                    curl --fail --show-error \
                        "http://${SERVER_IP}:8083/"
                '''
            }
        }
    }
}
